# Copy values into mode-specific files:
# - .env.dev.local
# - .env.prod.local
#
# Commands:
# - make dev   -> uses Vite mode "dev"
# - make prod  -> uses Vite mode "prod"

# Development
VITE_APP_ENV=dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=medicall-dev-f7395.firebaseapp.com
